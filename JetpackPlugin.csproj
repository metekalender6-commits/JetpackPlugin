<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>JetpackPlugin</AssemblyName>
    <RootNamespace>JetpackPlugin</RootNamespace>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <!-- CounterStrikeSharp API NuGet paketi. Sunucundaki CounterStrikeSharp
         sürümüyle uyumlu olması için gerekirse versiyonu değiştir. -->
    <PackageReference Include="CounterStrikeSharp.API" Version="1.*" />
  </ItemGroup>

</Project>
